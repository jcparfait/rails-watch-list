<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Reelist — Build your personal cinema" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Create personal movie collections and keep track of the films that matter to you.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Reelist">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar-watchlist" aria-label="Main navigation">
      <div class="navbar-watchlist-inner">
        <%= link_to root_path, class: "reelist-brand", aria: { label: "Reelist home" } do %>
          <% if asset_available?("logo/logoreelist.png") %>
            <%= image_tag "logo/logoreelist.png", class: "reelist-brand-logo", alt: "Reelist logo" %>
          <% else %>
            <span class="reelist-brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <% end %>
          <span class="reelist-brand-word">Reelist</span>
        <% end %>

        <div class="navbar-watchlist-actions">
          <% if user_signed_in? %>
            <%= link_to movie_night_path, class: "navbar-feature-action" do %>
              <span class="navbar-action-symbol" aria-hidden="true">◐</span>
              <span>Movie Night</span>
            <% end %>

            <%= link_to new_list_path, class: "navbar-primary-action" do %>
              <span class="navbar-action-symbol" aria-hidden="true">+</span>
              <span>New collection</span>
            <% end %>

            <%= link_to edit_user_registration_path, class: "navbar-user-action", aria: { label: "Account settings" } do %>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 12.25c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4Z" />
                <path d="M4.75 20.25c.64-3.32 3.56-5.75 7.25-5.75s6.61 2.43 7.25 5.75" />
              </svg>
            <% end %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "navbar-link" %>
            <%= link_to "Create account", new_user_registration_path, class: "navbar-primary-action" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if flash.any? %>
      <div class="app-flashes" aria-live="polite" aria-atomic="true">
        <% flash.each do |type, message| %>
          <div class="app-flash app-flash-<%= type %>" role="status" data-controller="flash" data-flash-delay-value="5500">
            <span><%= message %></span>
            <button type="button" class="app-flash-close" aria-label="Dismiss notification" data-action="flash#close">×</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
