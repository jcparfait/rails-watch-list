<% content_for :title, "Forgot password — Reelist" %>

<div class="home-page account-page auth-page">
  <section class="hero-section hero-section-with-back account-hero auth-hero">
    <%= link_to "← Back", new_user_session_path, class: "back-link" %>
    <p class="eyebrow">Password reset</p>
    <h1>Reset your password.</h1>
    <p class="hero-text">Enter your email and Reelist will send instructions to recover access to your cinema library.</p>
  </section>

  <section class="list-show-container account-grid account-grid-single auth-grid">
    <div class="list-form-card account-card account-card-main auth-card">
      <div class="account-card-header">
        <p class="eyebrow">Recovery</p>
        <h2>Find your account</h2>
        <p class="account-hint">Use the email linked to your Reelist account.</p>
      </div>

      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "account-form auth-form" }) do |f| %>
        <%= f.error_notification %>

        <%= f.input :email,
                    label: "Email",
                    required: true,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>

        <div class="account-actions">
          <%= f.button :submit, "Send reset instructions", class: "btn btn-primary" %>
          <%= link_to "Back to log in", new_session_path(resource_name), class: "btn btn-outline-light" %>
        </div>
      <% end %>

      <div class="auth-quick-links">
        <%= link_to "Create an account", new_registration_path(resource_name) %>
      </div>
    </div>
  </section>
</div>
