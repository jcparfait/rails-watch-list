<div class="container mt-4">
  <h1>Add a movie to <%= @list.name %></h1>

  <%= simple_form_for [@list, @bookmark] do |f| %>
    <%= f.association :movie, label_method: :title, value_method: :id, prompt: "Choose a movie" %>
    <%= f.input :comment %>
    <%= f.submit "Add movie", class: "btn btn-primary" %>
  <% end %>

  <%= link_to "Back to list", list_path(@list), class: "btn btn-link mt-3" %>
</div>
