<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1>My movie lists</h1>
      <p class="text-muted">Create lists and save your favorite movies.</p>
    </div>

    <%= link_to "New list", new_list_path, class: "btn btn-primary" %>
  </div>

  <div class="row">
    <% @lists.each do |list| %>
      <div class="col-12 col-md-6 col-lg-4 mb-4">
        <%= link_to list_path(list), class: "list-card" do %>
          <h2><%= list.name %></h2>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
