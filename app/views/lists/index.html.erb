<% content_for :title, "My collections — Reelist" %>

<div class="home-page home-page-portfolio">
  <section class="hero-section portfolio-hero portfolio-hero-cinema">
    <% if @hero_video.present? %>
      <video class="portfolio-hero-video"
             autoplay
             muted
             loop
             playsinline
             preload="metadata"
             poster="<%= @hero_video[:poster_url] %>">
        <source src="<%= @hero_video[:video_url] %>" type="video/mp4">
      </video>
    <% end %>

    <div class="portfolio-hero-video-shade" aria-hidden="true"></div>

    <div class="portfolio-hero-copy">
      <p class="eyebrow">Your film shelf</p>
      <h1>Save films into collections.</h1>
      <p class="hero-text">
        Search TMDB, organise your lists, rate what you watch, and find the right film for tonight.
      </p>

      <div class="portfolio-hero-actions">
        <%= link_to new_list_path, class: "hero-primary-action" do %>
          Create collection
          <span aria-hidden="true">+</span>
        <% end %>
        <%= link_to movie_night_path, class: "hero-secondary-action" do %>
          Try Movie Night
          <span aria-hidden="true">◐</span>
        <% end %>
      </div>
    </div>

    <aside class="portfolio-hero-panel" aria-label="Library summary">
      <span class="portfolio-hero-stat-value"><%= @lists.count %></span>
      <span class="portfolio-hero-stat-label"><%= "collection".pluralize(@lists.count) %></span>
      <p>Build a library that actually helps you choose what to watch.</p>
    </aside>

    <% if @hero_video.present? %>
      <%= link_to "Video by #{@hero_video[:author]} on Pexels",
                  @hero_video[:source_url],
                  target: "_blank",
                  rel: "noopener",
                  class: "portfolio-hero-credit" %>
    <% end %>
  </section>

  <section class="collections-section" id="collections">
    <div class="collections-heading">
      <div>
        <p class="eyebrow">Library</p>
        <h2>Your collections</h2>
      </div>
      <p>Organise films by mood, genre, memory or whatever makes sense to you.</p>
    </div>

    <% if @lists.any? %>
      <div class="lists-grid portfolio-lists-grid">
        <% @lists.each do |list| %>
          <% cover_image_url = list_cover_image_source(list) %>

          <%= link_to list_path(list), class: "list-card portfolio-list-card #{'list-card-no-cover' if cover_image_url.blank?}" do %>
            <% if cover_image_url.present? %>
              <%= image_tag cover_image_url,
                            class: "portfolio-list-card-image",
                            alt: list_cover_alt(list),
                            loading: "lazy" %>
            <% else %>
              <div class="portfolio-list-card-placeholder" aria-hidden="true"></div>
            <% end %>

            <div class="portfolio-list-card-shade" aria-hidden="true"></div>

            <div class="portfolio-list-card-top">
              <span class="list-card-label">Collection</span>
              <span class="portfolio-list-card-arrow" aria-hidden="true">↗</span>
            </div>

            <div class="list-card-content">
              <h3><%= list.name %></h3>
              <p><%= pluralize(list.movies.count, "film") %></p>
              <% if pexels_cover_credit?(list) %>
                <span class="portfolio-list-card-credit">Photo: <%= list.cover_image_author %> / Pexels</span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="portfolio-empty-state">
        <p class="eyebrow">Start here</p>
        <h2>Your library is waiting.</h2>
        <p>Create your first collection and begin building a cinema that belongs to you.</p>
        <%= link_to "Create your first collection", new_list_path, class: "hero-primary-action" %>
      </div>
    <% end %>
  </section>
</div>
