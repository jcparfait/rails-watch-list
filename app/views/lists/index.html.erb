<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My lists</h1>

    <%= link_to "New list", new_list_path, class: "btn btn-primary" %>
  </div>

  <% @lists.each do |list| %>
    <div class="card mb-3">
      <div class="card-body">
        <h2 class="h5 mb-0">
          <%= link_to list.name, list_path(list), class: "text-decoration-none" %>
        </h2>
      </div>
    </div>
  <% end %>
</div>
