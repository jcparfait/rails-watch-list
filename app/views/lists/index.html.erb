<% content_for :title, "My collections — Reelist" %>

<div class="home-page home-page-portfolio">
  <section class="hero-section portfolio-hero">
    <div class="portfolio-hero-copy">
      <p class="eyebrow">Your personal cinema</p>
      <h1>Keep the films that stay with you.</h1>
      <p class="hero-text">
        Build thoughtful collections, remember what you loved, and shape a film library that feels personal.
      </p>

      <div class="portfolio-hero-actions">
        <%= link_to new_list_path, class: "hero-primary-action" do %>
          Create a collection
          <span aria-hidden="true">↗</span>
        <% end %>
        <a href="#collections" class="hero-secondary-action">Browse collections</a>
      </div>
    </div>

    <div class="portfolio-hero-stat" aria-label="Collection summary">
      <span class="portfolio-hero-stat-value"><%= @lists.count %></span>
      <span class="portfolio-hero-stat-label"><%= "collection".pluralize(@lists.count) %></span>
    </div>
  </section>

  <section class="collections-section" id="collections">
    <div class="collections-heading">
      <div>
        <p class="eyebrow">Library</p>
        <h2>Your collections</h2>
      </div>
      <p>Organise films by mood, genre, memory or whatever makes sense to you.</p>
    </div>

    <% if @lists.any? %>
      <div class="lists-grid portfolio-lists-grid">
        <% @lists.each do |list| %>
          <% fallback_image_url =
            case list.name.downcase
            when /drama/
              "https://images.unsplash.com/photo-1485846234645-a62644f84728?q=80&w=1200&auto=format&fit=crop"
            when /comedy/
              "https://images.unsplash.com/photo-1527224538127-2104bb71c51b?q=80&w=1200&auto=format&fit=crop"
            when /classic/
              "https://images.unsplash.com/photo-1505686994434-e3cc5abf1330?q=80&w=1200&auto=format&fit=crop"
            when /rewatch/
              "https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=1200&auto=format&fit=crop"
            else
              "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1200&auto=format&fit=crop"
            end
          %>

          <% image_url =
            if list.photo.attached?
              cl_image_path list.photo.key, height: 700, width: 1100, crop: :fill
            else
              fallback_image_url
            end
          %>

          <%= link_to list_path(list),
                      class: "list-card portfolio-list-card",
                      style: "background-image: linear-gradient(180deg, rgba(8, 9, 14, 0.05), rgba(8, 9, 14, 0.92)), url('#{image_url}');" do %>
            <div class="portfolio-list-card-top">
              <span class="list-card-label">Collection</span>
              <span class="portfolio-list-card-arrow" aria-hidden="true">↗</span>
            </div>

            <div class="list-card-content">
              <h3><%= list.name %></h3>
              <p><%= pluralize(list.movies.count, "film") %></p>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="portfolio-empty-state">
        <p class="eyebrow">Start here</p>
        <h2>Your library is waiting.</h2>
        <p>Create your first collection and begin building a cinema that belongs to you.</p>
        <%= link_to "Create your first collection", new_list_path, class: "hero-primary-action" %>
      </div>
    <% end %>
  </section>
</div>
