<div class="home-page">
  <section class="hero-section hero-section-with-back">
    <%= link_to "← Back to lists", lists_path, class: "back-link" %>

    <div>
      <p class="eyebrow">New collection</p>
      <h1>Create a new list</h1>
      <p class="hero-text">
        Give your movie collection a name and add a cover image.
      </p>
    </div>
  </section>

  <section class="list-show-container">
    <div class="list-form-card">
      <%= simple_form_for @list do |f| %>
        <%= f.input :name,
                    label: "List name",
                    placeholder: "Drama, Comedy, Classics..." %>

        <%= f.input :photo,
                    as: :file,
                    label: "Cover image" %>

        <div class="d-flex gap-2 mt-3">
          <%= f.submit "Create list", class: "btn btn-primary" %>
          <%= link_to "Cancel", lists_path, class: "btn btn-outline-light" %>
        </div>
      <% end %>
    </div>
  </section>
</div>
