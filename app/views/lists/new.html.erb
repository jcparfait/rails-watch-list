<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-6">
      <h1>Add a movie</h1>
      <p class="text-muted">Add a movie to <strong><%= @list.name %></strong></p>

      <%= simple_form_for [@list, @bookmark] do |f| %>
        <%= f.association :movie,
                          label_method: :title,
                          value_method: :id,
                          prompt: "Choose a movie" %>

        <%= f.input :comment,
                    placeholder: "Why do you want to save this movie?" %>

        <div class="d-flex gap-2">
          <%= f.submit "Add movie", class: "btn btn-primary" %>
          <%= link_to "Cancel", list_path(@list), class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
