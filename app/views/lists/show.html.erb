<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @list.name %></h1>

    <div>
      <%= link_to "Add movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
      <%= link_to "Back to lists", lists_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <% if @list.bookmarks.any? %>
    <div class="row">
      <% @list.bookmarks.each do |bookmark| %>
        <div class="col-12 col-md-4 mb-4">
          <div class="card h-100">
            <%= image_tag bookmark.movie.poster_url, class: "card-img-top", alt: bookmark.movie.title %>

            <div class="card-body">
              <h2 class="h5"><%= bookmark.movie.title %></h2>

              <p><%= bookmark.movie.overview %></p>

              <p>
                <strong>Rating:</strong>
                <%= bookmark.movie.rating %>
              </p>

              <p>
                <strong>Comment:</strong>
                <%= bookmark.comment %>
              </p>

              <%= link_to "Delete",
                          bookmark_path(bookmark),
                          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                          class: "btn btn-outline-danger btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No movies in this list yet.</p>
  <% end %>
</div>
