<div class="home-page">
  <section class="hero-section hero-section-with-back list-hero-image">
    <%= link_to "← Back to lists", lists_path, class: "back-link" %>

    <% if @list.photo.attached? %>
      <%= image_tag @list.photo,
                    class: "list-show-cover",
                    alt: "#{@list.name} collection cover" %>
    <% else %>
      <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1200&auto=format&fit=crop"
           class="list-show-cover"
           alt="Cinema">
    <% end %>

    <div class="list-hero-overlay"></div>

    <div class="list-hero-content">
      <p class="eyebrow">Movie list</p>
      <h1><%= @list.name %></h1>
      <p class="hero-text"><%= pluralize(@list.bookmarks.count, "movie") %> saved in this list.</p>

      <div class="d-flex flex-wrap gap-2 mt-3">
        <%= link_to "Search a movie", list_movie_search_path(@list), class: "btn btn-primary btn-sm" %>
        <%= link_to "Edit collection", edit_list_path(@list), class: "btn btn-outline-light btn-sm" %>
        <%= link_to "Delete collection",
                    list_path(@list),
                    data: { turbo_method: :delete, turbo_confirm: "Delete this collection and all its saved films?" },
                    class: "btn btn-outline-danger btn-sm" %>
      </div>
    </div>
  </section>

  <section class="list-show-container">
    <% if @list.bookmarks.any? %>
      <div class="movies-grid">
        <% @list.bookmarks.each do |bookmark| %>
          <div class="movie-card">
            <% if bookmark.movie.poster_url.present? %>
              <%= image_tag bookmark.movie.poster_url, alt: bookmark.movie.title %>
            <% else %>
              <div class="empty-state">No poster</div>
            <% end %>

            <div class="movie-card-body">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <h2 class="movie-title"><%= bookmark.movie.title %></h2>
                <span class="movie-rating"><%= bookmark.movie.rating.to_f.round(1) %></span>
              </div>

              <% if bookmark.movie.release_date.present? %>
                <p class="text-secondary"><%= bookmark.movie.release_date.year %></p>
              <% end %>

              <p class="movie-overview"><%= bookmark.movie.overview %></p>
              <p class="movie-comment"><strong>Personal note:</strong> <%= bookmark.comment %></p>

              <div class="d-flex flex-wrap gap-2">
                <%= link_to "Edit note", edit_bookmark_path(bookmark), class: "btn btn-outline-light btn-sm" %>
                <%= link_to "Remove movie",
                            bookmark_path(bookmark),
                            data: { turbo_method: :delete, turbo_confirm: "Remove this movie from the collection?" },
                            class: "btn btn-outline-danger btn-sm" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p>No movies in this list yet.</p>
        <%= link_to "Search TMDB", list_movie_search_path(@list), class: "btn btn-primary mt-2" %>
      </div>
    <% end %>

    <section id="reviews" class="reviews-section mt-5">
      <div class="reviews-header mb-4">
        <div>
          <p class="eyebrow">Your notes</p>
          <h2>Reviews</h2>
        </div>

        <% if @list.reviews.any? %>
          <% average_rating = @list.reviews.average(:rating).to_f.round(1) %>
          <div class="average-rating">
            <span class="average-rating-score"><%= average_rating %>/5</span>
            <span class="average-rating-star">★</span>
          </div>
        <% end %>
      </div>

      <% if @list.reviews.any? %>
        <div class="reviews-list mb-4">
          <% @list.reviews.each do |review| %>
            <div class="review-card">
              <div>
                <strong><%= "★" * review.rating %><%= "☆" * (5 - review.rating) %></strong>
                <p><%= review.content %></p>
              </div>

              <% if review.user == current_user %>
                <div class="d-flex gap-3">
                  <%= link_to "Edit", edit_review_path(review), class: "review-delete-link" %>
                  <%= link_to "Delete",
                              review_path(review),
                              data: { turbo_method: :delete, turbo_confirm: "Delete this review?" },
                              class: "review-delete-link" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-reviews mb-4">
          <p>No reviews yet.</p>
        </div>
      <% end %>

      <div class="review-form-card">
        <div class="review-form-header">
          <p class="eyebrow">Add your opinion</p>
          <h3>Leave a review</h3>
        </div>

        <%= simple_form_for [@list, @review] do |f| %>
          <%= f.input :content, label: false, placeholder: "What do you think about this list?" %>
          <div class="review-rating-row">
            <%= f.input :rating, label: false, collection: 0..5, prompt: "Rating" %>
            <%= f.submit "Add review", class: "btn btn-review" %>
          </div>
        <% end %>
      </div>
    </section>
  </section>
</div>
