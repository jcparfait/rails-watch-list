<div class="home-page">
  <section class="hero-section hero-section-with-back list-hero-image">
    <%= link_to "← Back to lists", lists_path, class: "back-link" %>

    <% if @list.photo.attached? %>
      <%= image_tag @list.photo,
                    class: "list-show-cover",
                    alt: "#{@list.name} collection cover" %>
    <% else %>
      <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1200&auto=format&fit=crop"
           class="list-show-cover"
           alt="Cinema">
    <% end %>

    <div class="list-hero-overlay"></div>

    <div class="list-hero-content">
      <p class="eyebrow">Movie list</p>
      <h1><%= @list.name %></h1>
      <p class="hero-text"><%= pluralize(@list.bookmarks.count, "movie") %> saved in this list.</p>

      <div class="d-flex flex-wrap gap-2 mt-3">
        <%= link_to "Search a movie", list_movie_search_path(@list), class: "btn btn-primary btn-sm" %>
        <%= link_to "Edit collection", edit_list_path(@list), class: "btn btn-outline-light btn-sm" %>
        <%= link_to "Delete collection",
                    list_path(@list),
                    data: { turbo_method: :delete, turbo_confirm: "Delete this collection and all its saved films?" },
                    class: "btn btn-outline-danger btn-sm" %>
      </div>
    </div>
  </section>

  <section class="list-show-container">
    <% if @list.bookmarks.any? %>
      <div class="movies-grid">
        <% @list.bookmarks.each do |bookmark| %>
          <% movie = bookmark.movie %>
          <% app_reviews = movie.movie_reviews.to_a.sort_by(&:created_at).reverse %>
          <% current_user_review = app_reviews.find { |review| review.user_id == current_user.id } %>
          <% average_rating = (app_reviews.sum(&:rating).to_f / app_reviews.size).round(1) if app_reviews.any? %>

          <div class="movie-card" id="movie-<%= movie.id %>">
            <% if movie.poster_url.present? %>
              <%= image_tag movie.poster_url, alt: movie.title %>
            <% else %>
              <div class="empty-state">No poster</div>
            <% end %>

            <div class="movie-card-body">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <h2 class="movie-title"><%= movie.title %></h2>
                <span class="movie-rating">TMDB <%= movie.rating.to_f.round(1) %></span>
              </div>

              <div class="movie-meta-row">
                <% if movie.release_date.present? %>
                  <span><%= movie.release_date.year %></span>
                <% end %>

                <% if app_reviews.any? %>
                  <span class="app-rating">App rating <%= average_rating %>/5 · <%= pluralize(app_reviews.size, "review") %></span>
                <% else %>
                  <span class="app-rating">No app rating yet</span>
                <% end %>
              </div>

              <p class="movie-overview"><%= movie.overview %></p>

              <% if bookmark.comment.present? %>
                <p class="movie-comment"><strong>Collection note:</strong> <%= bookmark.comment %></p>
              <% end %>

              <div class="movie-review-panel">
                <h3>Your film review</h3>

                <%= form_with url: movie_movie_reviews_path(movie), method: :post, class: "movie-review-form" do %>
                  <%= hidden_field_tag :list_id, @list.id %>

                  <div class="movie-review-fields">
                    <%= select_tag "movie_review[rating]",
                                   options_for_select((0..5).map { |rating| ["#{rating}/5", rating] }, current_user_review&.rating),
                                   prompt: "Your rating",
                                   class: "form-select",
                                   required: true %>

                    <%= text_area_tag "movie_review[content]",
                                      current_user_review&.content,
                                      class: "form-control",
                                      rows: 3,
                                      placeholder: "Write your comment about this film…",
                                      required: true %>
                  </div>

                  <div class="d-flex flex-wrap gap-2 mt-2">
                    <%= submit_tag current_user_review.present? ? "Update my review" : "Save my review", class: "btn btn-primary btn-sm" %>

                    <% if current_user_review.present? %>
                      <%= link_to "Delete my review",
                                  movie_review_path(current_user_review, list_id: @list.id),
                                  data: { turbo_method: :delete, turbo_confirm: "Delete your review for this film?" },
                                  class: "btn btn-outline-danger btn-sm" %>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <details class="movie-community-reviews">
                <summary>
                  <span>Show app comments</span>
                  <span><%= app_reviews.size %></span>
                </summary>

                <% if app_reviews.any? %>
                  <div class="movie-community-reviews-list">
                    <% app_reviews.each do |review| %>
                      <article class="movie-community-review">
                        <div class="movie-community-review-header">
                          <strong><%= review.user == current_user ? "You" : "Reelist user" %></strong>
                          <span><%= "★" * review.rating %><%= "☆" * (5 - review.rating) %></span>
                        </div>
                        <p><%= review.content %></p>
                      </article>
                    <% end %>
                  </div>
                <% else %>
                  <p class="movie-community-reviews-empty">No comment from app users yet.</p>
                <% end %>
              </details>

              <div class="d-flex flex-wrap gap-2 mt-3">
                <%= link_to "Edit collection note", edit_bookmark_path(bookmark), class: "btn btn-outline-light btn-sm" %>
                <%= link_to "Remove movie",
                            bookmark_path(bookmark),
                            data: { turbo_method: :delete, turbo_confirm: "Remove this movie from the collection?" },
                            class: "btn btn-outline-danger btn-sm" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p>No movies in this list yet.</p>
        <%= link_to "Search TMDB", list_movie_search_path(@list), class: "btn btn-primary mt-2" %>
      </div>
    <% end %>
  </section>
</div>
