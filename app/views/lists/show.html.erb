<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1><%= @list.name %></h1>
      <p class="text-muted"><%= pluralize(@list.bookmarks.count, "movie") %> in this list</p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to "Add movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
      <%= link_to "Back", lists_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <% if @list.bookmarks.any? %>
    <div class="row">
      <% @list.bookmarks.each do |bookmark| %>
        <div class="col-12 col-md-6 col-lg-4 mb-4">
          <div class="movie-card">
            <%= image_tag bookmark.movie.poster_url, alt: bookmark.movie.title %>

            <div class="movie-card-body">
              <h2 class="movie-title"><%= bookmark.movie.title %></h2>

              <p class="movie-overview">
                <%= bookmark.movie.overview %>
              </p>

              <p>
                <strong>Rating:</strong>
                <%= bookmark.movie.rating %>
              </p>

              <p class="movie-comment">
                <strong>Comment:</strong>
                <%= bookmark.comment %>
              </p>

              <%= link_to "Delete",
                          bookmark_path(bookmark),
                          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                          class: "btn btn-outline-danger btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5">
      <p class="text-muted">No movies in this list yet.</p>
      <%= link_to "Add your first movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
