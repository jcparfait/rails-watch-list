# Copy this file to .env and fill in these values.

# Recommended: paste the TMDB "API Read Access Token" here.
TMDB_API_TOKEN=

# Alternative: paste the TMDB "API Key (v3 auth)" here.
TMDB_API_KEY=

# Required for collection cover image search and home hero video.
# Get one from your Pexels account API settings.
PEXELS_API_KEY=

# Optional demo account used by db/seeds.rb.
DEMO_USER_EMAIL=demo@reelist.app
DEMO_USER_PASSWORD=password

# Production only. Host without protocol.
# For a custom domain, use the canonical www host, for example www.reelist.app.
# If APP_HOST starts with www., requests to the naked domain are redirected to www.
APP_HOST=
