# Copy this file to .env and fill in these values.

# Recommended: paste the TMDB "API Read Access Token" here.
TMDB_API_TOKEN=

# Alternative: paste the TMDB "API Key (v3 auth)" here.
TMDB_API_KEY=

# Required for collection cover image search.
# Get one from your Pexels account API settings.
PEXELS_API_KEY=
